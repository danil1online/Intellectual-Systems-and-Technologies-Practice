FROM python:3.10-slim-bookworm

# Системные зависимости
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list && \
    sed -i 's|http://security.debian.org|https://security.debian.org|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        git \
        openssh-client \
        jq \
    && rm -rf /var/lib/apt/lists/*

# Python зависимости для CI/CD
RUN pip install --no-cache-dir \
    jupyter_client \
    nbformat \
    nbconvert \
    requests \
    openai \
    python-dotenv \
    numpy \
    pandas \
    ipykernel

# Создание директорий
RUN mkdir -p /runner/work /runner/scripts

# Копирование скриптов
COPY runner/entrypoint.sh /runner/entrypoint.sh
COPY runner/scripts/grade_notebook.py /runner/scripts/grade_notebook.py
COPY runner/scripts/grade_md.py /runner/scripts/grade_md.py
COPY runner/scripts/auto_grade.py /runner/scripts/auto_grade.py

RUN chmod +x /runner/entrypoint.sh
RUN chmod +x /runner/scripts/grade_notebook.py
RUN chmod +x /runner/scripts/grade_md.py
RUN chmod +x /runner/scripts/auto_grade.py

WORKDIR /runner
