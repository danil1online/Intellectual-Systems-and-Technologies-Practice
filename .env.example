# ============================================
# МУЛЬТИСИСТЕМНЫЙ УЧЕБНЫЙ КОМПЛЕКС
# ============================================

# === ПОРТЫ ===
JUPYTERHUB_PORT=8000
DASHBOARD_PORT=9000
NEXTCLOUD_PORT=8080
ZITADEL_PORT=9200
HOST_DOMAIN=localhost

# === GITLAB ===
# Единый адрес GitLab (доступен из лабсети и из интернета)
# Только один адрес, меняется только пересозданием volumes
GITLAB_EXTERNAL_URL=http://localhost

# === LLM для ментора ===
# Тип: "openai" или "local"
LLM_MENTOR_TYPE=local
# Endpoint OpenAI (без /v1/)
LLM_MENTOR_BASE_URL=http://192.168.2.75:8080
LLM_MENTOR_API_KEY=sk-placeholder
# Для локальной модели
LLM_USE_LOCAL=false
GGUF_PATH=/home/user1/Downloads/Qwen3.5-0.8B-Q4_K_M.gguf

# === LLM для CI/CD ===
LLM_CI_TYPE=local
LLM_CI_BASE_URL=http://192.168.2.75:8080
LLM_CI_API_KEY=sk-placeholder

# === Zitadel ===
ZITADEL_ADMIN_PASSWORD=zitadel-admin-$(openssl rand -hex 16)
# OIDC Client IDs (будут сгенерированы init_zitadel.sh)
JH_ZITADEL_CLIENT_ID=placeholder
JH_ZITADEL_CLIENT_SECRET=placeholder
DASH_CLIENT_ID=placeholder
DASH_CLIENT_SECRET=placeholder

# === GitLab ===
GITLAB_ROOT_PASSWORD=gitlab-root-$(openssl rand -hex 16)
GITLAB_ADMIN_TOKEN=glpat-placeholder

# === JupyterHub ===
JH_API_TOKEN=hub-$(openssl rand -hex 32)

# === Nextcloud ===
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=nc-admin-$(openssl rand -hex 16)

# === OnlyOffice ===
ONLYOFFICE_JWT_SECRET=onlyoffice-$(openssl rand -hex 16)
