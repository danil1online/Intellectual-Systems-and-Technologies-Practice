# ============================================
# МУЛЬТИСИСТЕМНЫЙ УЧЕБНЫЙ КОМПЛЕКС
# Скопируйте в .env и отредактируйте
# ============================================

JUPYTERHUB_PORT=8000
DASHBOARD_PORT=9000
GITLAB_HOST=localhost
GITLAB_EXTERNAL_URL=http://localhost

LLM_MENTOR_TYPE=local
LLM_MENTOR_BASE_URL=http://llm:8080/v1
LLM_MENTOR_API_KEY=local-api-key

LLM_CI_TYPE=local
LLM_CI_BASE_URL=http://llm:8080/v1
LLM_CI_API_KEY=local-api-key

LLM_USE_LOCAL=true
GGUF_PATH=/models/model.gguf
LLM_MENTOR_MODEL=gpt-4o
LLM_CI_MODEL=gpt-4o

LECTURER_01_PASSWORD=<auto-generated>
LECTURER_02_PASSWORD=<auto-generated>

GITLAB_ROOT_PASSWORD=<auto-generated>
GITLAB_ADMIN_TOKEN=glpat-placeholder

JH_API_TOKEN=<auto-generated>

REGISTRY_PORT=5050
