# ============================================
# МУЛЬТИСИСТЕМНЫЙ УЧЕБНЫЙ КОМПЛЕКС
# .gitignore
# ============================================

# --- Environment & secrets ---
# Шаблон env-файлов — ОСТАВЛЯЕМ в репозитории
# .env.example
#
# Реальные файлы с секретами — ИГНОРИРУЕМ
.env
.env.jupyterhub

# --- Docker volumes & runtime data ---
# Данные GitLab (бД, репозитории, секреты, логи)
shared/data/gitlab-data/
shared/data/gitlab-config/
shared/data/gitlab-logs/
# Данные Nextcloud (файлы пользователей)
shared/data/nextcloud-data/
# Конфигурация Runner (генерируется при установке)
shared/data/runner-config/
# LLM модели (большие файлы, скачиваются отдельно)
shared/data/llm-models/
# OIDC секреты
shared/data/oidc/
# Pip-кэш и Python-пакеты
shared/data/shared-packages/
# Логи
shared/logs/

# --- Jupyter checkpoints ---
.ipynb_checkpoints/

# --- IDE & editors ---
.vscode/
.idea/
*.swp
*.swo
*~
opencode.json
.opencode.json.swp

# --- Data files (large archives, datasets) ---
data/
data.zip*

# --- Session & temp files ---
session-*.md

# --- OS files ---
.DS_Store
Thumbs.db
